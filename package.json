{
  "name": "petgame",
  "private": true,
  "version": "0.1.0",
  "description": "Top-down monster-taming survival game for web & mobile, up to 5 players",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=@petgame/server",
    "dev:client": "npm run dev --workspace=@petgame/client",
    "build": "npm run build --workspace=@petgame/client",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "play": "npm run build && npm start --workspace=@petgame/server",
    "shots": "node scripts/shots.mjs",
    "photo3d": "node scripts/photo3d.mjs",
    "photo3d:web": "node scripts/photo3d.mjs --web",
    "photo3d:ai-setup": "node scripts/photo3d-ai-setup.mjs",
    "sprite": "node scripts/photo3d.mjs --sprite"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "three": "^0.186.1",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}

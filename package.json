{
  "name": "petgame",
  "private": true,
  "version": "0.1.0",
  "description": "Top-down monster-taming survival game for web & mobile, up to 5 players",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "npm run dev --workspace=@petgame/server",
    "dev:client": "npm run dev --workspace=@petgame/client",
    "build": "npm run build --workspace=@petgame/client",
    "typecheck": "tsc -p packages/shared && tsc -p packages/server && tsc -p packages/client && tsc -p assets",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "models:build": "tsx assets/pals/build.ts",
    "assets:kaykit": "tsx assets/kaykit/import.ts",
    "play": "npm run build && npm start --workspace=@petgame/server"
  },
  "devDependencies": {
    "@colyseus/testing": "^0.18.6",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
